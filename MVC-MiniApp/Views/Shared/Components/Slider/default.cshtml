@model IEnumerable<SliderInfoUIVM>

<div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">
    <!-- Indicators -->
    <ol class="carousel-indicators">
        @for (int i = 0; i < Model.Count(); i++)
        {
            <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></li>
        }
    </ol>

    <!-- Slides -->
    <div class="carousel-inner">
        @for (int i = 0; i < Model.Count(); i++)
        {
            var slider = Model.ElementAt(i);
            <div class="carousel-item @(i == 0 ? "active" : "")">
                <div class="py-5 row d-flex align-items-center">
                    <div class="banner-content col-lg-8 col-8 offset-2 m-lg-auto text-left py-5 pb-5">
                        <h1 class="banner-heading h1 text-secondary display-3 mb-0 pb-3 mx-0 px-0 light-300">
                            @slider.Title
                        </h1>
                        <p class="banner-body text-muted py-3">
                            @slider.Description
                        </p>
                        <a class="banner-button btn rounded-pill btn-outline-primary btn-lg px-4" href="#" role="button">Get Started</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Controls -->
    <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-bs-slide="prev">
        <i class='bx bx-chevron-left'></i>
        <span class="visually-hidden">Previous</span>
    </a>
    <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-bs-slide="next">
        <i class='bx bx-chevron-right'></i>
        <span class="visually-hidden">Next</span>
    </a>
</div>

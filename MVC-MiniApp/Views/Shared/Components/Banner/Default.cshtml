@model AboutVM

<section class="bg-light w-100">
    <div class="container">
        <div class="row d-flex align-items-center py-5">
            <div class="col-lg-6 text-start">
                <h1 class="h2 py-5 text-primary typo-space-line">About Us</h1>
                <p class="light-300">
                    @Model.Description <a rel="nofollow" href="http://freepik.com/" target="_blank">FreePik</a> website. Purple Buzz is provided by TemplateMo.
                </p>
            </div>
            <div class="col-lg-6">
                <img src="~/img/@Model.Image" alt="About Image" />
            </div>
        </div>
    </div>
</section>

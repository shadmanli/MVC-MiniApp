<style>
    #basket-link {
        cursor: pointer;
        position: relative;
    }

    #basket-count {
        display: none;
        position: absolute;
        top: 0;
        right: 0;
        transform: translate(50%, -50%);
        padding: 0 6px;
        height: 20px;
        line-height: 20px;
        font-size: 0.75rem;
        font-weight: bold;
        color: white;
        background-color: darkblue;
        border-radius: 50%;
        min-width: 20px;
        text-align: center;
        white-space: nowrap;
    }
</style>

<nav id="main_nav" class="navbar navbar-expand-lg navbar-light bg-white shadow">
    <div class="container d-flex justify-content-between align-items-center">
        <a class="navbar-brand h1" href="index.html">
            <i class='bx bx-buildings bx-sm text-dark'></i>
            <span class="text-dark h4">Purple</span> <span class="text-primary h4">Buzz</span>
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbar-toggler-success" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="align-self-center collapse navbar-collapse flex-fill d-lg-flex justify-content-lg-between"
             id="navbar-toggler-success">

            <div class="flex-fill mx-xl-5 mb-2">
                <ul class="nav navbar-nav d-flex justify-content-between mx-xl-5 text-center text-dark">
                    <li class="nav-item"><a class="nav-link btn-outline-primary rounded-pill px-3" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link btn-outline-primary rounded-pill px-3" asp-controller="About" asp-action="Index">About</a></li>
                    <li class="nav-item"><a class="nav-link btn-outline-primary rounded-pill px-3" asp-controller="Work" asp-action="Index">Work</a></li>
                    <li class="nav-item"><a class="nav-link btn-outline-primary rounded-pill px-3" asp-controller="Contact" asp-action="Index">Contact</a></li>
                    <li class="nav-item">
                        @if (User.Identity.IsAuthenticated && (User.IsInRole("SuperAdmin") || User.IsInRole("Admin")))
                        {
                            <a class="nav-link" asp-area="Admin" asp-controller="DashBoard" asp-action="Index">Admin</a>
                        }
                    </li>
                </ul>
            </div>

            <div class="navbar align-self-center d-flex">
                <a class="nav-link" href="#"><i class='bx bx-bell bx-sm bx-tada-hover text-primary'></i></a>

                <!-- Basket Icon -->
                <a class="nav-link position-relative" asp-controller="Basket" asp-action="Index" id="basket-link">
                    <i class='bx bx-cart bx-sm text-primary'></i>
                    <span id="basket-count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill">0</span>
                </a>

                <!-- User Icon with dropdown -->
                <div class="nav-item dropdown">
                    <a class="nav-link" href="#" id="userDropdown" role="button">
                        <i class='bx bx-user-circle bx-sm text-primary'></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end text-center" style="    margin-left: -2pc;" aria-labelledby="userDropdown" id="userDropdownMenu">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li><a class="dropdown-item disabled" href="#">👤 @User.Identity.Name</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="dropdown-item text-danger">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Register">Register</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Login">Login</a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</nav>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const basketCountEl = document.getElementById("basket-count");
        const userDropdown = document.getElementById("userDropdown");
        const userDropdownMenu = document.getElementById("userDropdownMenu");

        function updateBasketCount() {
            let current = parseInt(basketCountEl.textContent) || 0;
            current++;
            basketCountEl.textContent = current;
            basketCountEl.style.display = "inline-block";
        }

        document.querySelectorAll(".add-to-basket-btn").forEach(btn => {
            btn.addEventListener("click", function(e) {
                e.preventDefault();
                updateBasketCount();
            });
        });

        userDropdown.addEventListener("click", function(e) {
            e.preventDefault();
            userDropdownMenu.classList.toggle("show");
        });

        document.addEventListener("click", function(e) {
            if (!userDropdown.contains(e.target) && !userDropdownMenu.contains(e.target)) {
                userDropdownMenu.classList.remove("show");
            }
        });
    });
</script>

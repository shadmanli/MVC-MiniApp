@model IEnumerable<OurWorkUIVM>

<section class="service-wrapper py-3">
    <div class="container-fluid pb-3">
        <div class="row">
            <h2 class="h2 text-center col-12 py-5 semi-bold-600">Services</h2>
            <div class="service-header col-2 col-lg-3 text-end light-300">
                <i class='bx bx-gift h3 mt-1'></i>
            </div>
            <div class="service-heading col-10 col-lg-9 text-start float-end light-300">
                <h2 class="h3 pb-4 typo-space-line">Make Success for future</h2>
            </div>
        </div>
        <p class="service-footer col-10 offset-2 col-lg-9 offset-lg-3 text-start pb-3 text-muted px-2">
            You are free to use this template for your commercial or business websites.
        </p>
    </div>

    <div class="service-tag py-5 bg-secondary">
        <div class="col-md-12">
            <ul class="nav d-flex justify-content-center">
                <li class="nav-item mx-lg-4">
                    <a class="filter-btn nav-link btn-outline-primary active shadow rounded-pill text-light px-4 light-300" href="#" data-filter=".project">All</a>
                </li>

                @{
                    var categories = Model
                    .Select(x => !string.IsNullOrEmpty(x.CategoryName) ? x.CategoryName : "Default")
                    .Distinct()
                    .ToList();
                }

                @foreach (var cat in categories)
                {
                    var catClass = cat.Replace(" ", "").ToLower();
                    <a class="filter-btn btn rounded-pill btn-outline-primary border-0 m-md-2 px-md-4"
                       data-filter=".@catClass" href="#">@cat</a>
                }
            </ul>
        </div>
    </div>
</section>

<section class="container overflow-hidden py-5">
    <div class="row gx-5 gx-sm-3 gx-lg-5 gy-lg-5 gy-3 pb-3 projects">

        @foreach (var item in Model)
        {
            var catClass = !string.IsNullOrEmpty(item.CategoryName) ? item.CategoryName.Replace(" ", "").ToLower() : "default";
            <div class="col-xl-3 col-md-4 col-sm-6 project @catClass">
                <div class="service-work card border-0 text-white shadow-sm overflow-hidden mx-5 m-sm-0">
                    <img class="service card-img" src="@Url.Content("~/img/" + item.MainImage)" alt="Card image">
                    <div class="service-work-vertical card-img-overlay d-flex align-items-end">
                        <div class="service-work-content text-left text-light">
                            <span class="btn btn-outline-light rounded-pill mb-lg-3 px-lg-4 light-300">@item.Name</span>
                            <p class="card-text">@item.Description</p>
                            <p class="card-text fw-bold">@item.Price.ToString("0.00") $</p>

                            <button style="background-color: transparent;color:white; border:none;"
                                    class="btn btn-success add-to-basket-btn"
                                    data-id="@item.Id">
                                Add to Basket
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }


    </div>
</section>

<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1055">
    <div id="basketToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                Product added to basket!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    $(document).ready(function(){
        $('.filter-btn').click(function(e){
            e.preventDefault();
            var filter = $(this).data('filter');

            $('.filter-btn').removeClass('active');
            $(this).addClass('active');

            if(filter == '.project'){
                $('.project').show();
            } else {
                $('.project').hide();
                $(filter).show();
            }
        });

        $('.add-to-basket-btn').click(function(){
            var workId = $(this).data('id');

            fetch('/Basket/AddToBasket', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ workId: workId, count: 1 })
            })
            .then(res => {
                if(res.ok){
                    var toastEl = document.getElementById('basketToast');
                    var toast = new bootstrap.Toast(toastEl, { delay: 1500 });
                    toast.show();
                }
            });
        });
    });
</script>

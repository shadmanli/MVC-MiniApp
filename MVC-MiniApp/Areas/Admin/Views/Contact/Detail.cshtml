@model ContactVM


<div class="container center-container">
    <div class="card shadow-lg p-4" style="max-width: 500px; margin:auto; border-radius: 15px;">
        <h3 class="text-center mb-4">Team Member Detail</h3>

        <div class="text-center mb-3">
            <img src="~/img/@Model.Image"
                 alt="@Model.Title"
                 class="img-fluid rounded-circle shadow"
                 style="width:150px; height:150px; object-fit:cover;" />
        </div>

        <div class="mb-3 text-center">
            <h4 class="mb-1">@Model.Description</h4>
            <p class="text-muted mb-0"><strong>Position:</strong> @Model.Description</p>
        </div>

        <div class="text-center mt-4">
            <a asp-action="Index" class="btn btn-secondary px-4">Back to List</a>
        </div>
    </div>
</div>

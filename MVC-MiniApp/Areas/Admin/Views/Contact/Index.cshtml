
@model ContactVM


<div class="container center-container">
    <h2 class="mt-5">Contact</h2>

    @if (Model != null)
    {
        <div class="card mt-4 p-4 shadow-lg">
            <div class="text-center">
                <img src="~/img/@Model.Image" alt="Image" style="width:200px;height:200px;object-fit:cover;border-radius:10px;" />
            </div>

            <h3 class="mt-3 text-center">@Model.Title</h3>
            <p class="mt-2 text-muted text-center">@Model.Description</p>

            <div class="text-center mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger delete-contact-btn">Delete</a>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-4">No contact information found.</div>
        <a asp-action="Create" class="btn btn-secondary">Create</a>
    }
</div>

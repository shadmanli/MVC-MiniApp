@model AboutVM

<div class="container center-container">
    <h2 class="mt-5">About</h2>

    @if (Model == null)
    {
        @if (User.Identity.IsAuthenticated && User.IsInRole("SuperAdmin"))
        {
            <a asp-action="Create" class="btn btn-success">Create</a>

        }
        <p class="mt-3 text-muted">Hal-hazırda heç bir məlumat yoxdur.</p>
    }
    else
    {
        <div class="mb-3">
            @if (User.Identity.IsAuthenticated && User.IsInRole("SuperAdmin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>

            }
            @if (User.Identity.IsAuthenticated && User.IsInRole("SuperAdmin"))
            {
                <button data-id="@Model.Id" class="btn btn-danger delete-about-btn">Delete</button>
            }
        </div>

        <div id="about-table">
            <table class="table table-striped table-bordered table-hover mt-4">
                <thead class="table-dark">
                    <tr>
                        <th>Image</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <img src="~/img/@Model.Image" style="width:150px;height:150px;object-fit:cover;" />
                        </td>
                        <td>@Model.Description</td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>



@model AboutEditVM

<main>
    <div class="container  center-container" style="margin-top:160px;margin-left:320px; width:500px">
        <form class="row g-3" asp-action="Edit" method="post" enctype="multipart/form-data">

         
            <input type="hidden" asp-for="Id" />

            <div class="col-12">
                <label for="Descrition" class="form-label">Description</label>
                <input asp-for="Description" class="form-control" id="descrition" maxlength="100">
                <span class="text-danger" asp-validation-for="Description"></span>
            </div>

            <div class="mb-3">
                <label asp-for="UploadImage" class="form-label">Upload New Images:</label>
                <input asp-for="UploadImage" type="file" accept="image/*" class="form-control" />
                <span asp-validation-for="UploadImage" class="text-danger"></span>
            </div>

            <div class="text-center mt-3">
                <button type="submit" class="btn btn-primary">Submit</button>
                <a asp-action="Index" class="btn btn-light">Cancel</a>
            </div>

        </form>
    </div>
</main>

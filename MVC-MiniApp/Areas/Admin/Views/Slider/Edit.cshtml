@model SliderEditVM

<div class="container center-container">
    <h2 class="mt-5">Edit Slider</h2>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="UploadImage" class="form-label">Upload New Image</label>
            <input asp-for="UploadImage" type="file" class="form-control" />
            <span asp-validation-for="UploadImage" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </form>
</div>

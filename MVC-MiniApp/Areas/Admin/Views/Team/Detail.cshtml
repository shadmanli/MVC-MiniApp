@model TeamVM
<div class="container  center-container">
    <h3>Team</h3>

    <div class="mt-3">

        <img src="/img/@Model.Image" style="width:150px;height:150px; object-fit:cover;" alt="@Model.Description" />
    </div>

    <div class="mt-3">

        <p><strong>Position:</strong> @Model.Position</p>
    </div>
    <div class="mt-3">

        <p><strong>Name:</strong> @Model.Name</p>
    </div>

    <a asp-action="Index" class="btn btn-secondary mt-3">Back to Index</a>
</div>

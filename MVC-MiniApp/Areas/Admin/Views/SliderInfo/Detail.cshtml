@model SliderInfoVM


<div class="container center-container">
    <div class="card shadow-lg p-4" style="max-width: 500px; margin:auto; border-radius: 15px;">
        <h3 class="text-center mb-4">Slider Detail</h3>

        <div class="mb-3 text-center">
            <p class="text-muted mb-1"><strong>Title:</strong> @Model.Title</p>
            <p class="text-muted mb-0"><strong>Description:</strong> @Model.Description</p>
        </div>

        <div class="text-center mt-4">
            <a asp-action="Index" class="btn btn-secondary px-4">Back to List</a>
        </div>
    </div>
</div>


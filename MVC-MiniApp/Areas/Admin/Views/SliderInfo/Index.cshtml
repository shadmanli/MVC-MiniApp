
@model IEnumerable<SliderInfoVM>

<div class="container center-container">
    <h2 class="mt-5">SliderInfo</h2>
    @if (User.Identity.IsAuthenticated && User.IsInRole("SuperAdmin"))
    {
        <a asp-action="Create" class="btn btn-secondary">Create</a>
    }
    <table class="table table-striped table-bordered table-hover mt-4">
        <thead class="table-dark">
            <tr>
                
                <th>Title</th>
                <th>Description</th>

                <th>Operations</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    
                    <td>@item.Title</td>
                    <td>@item.Description</td>
                    <td>
                        @if (User.Identity.IsAuthenticated && User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                        {
                            <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-dark">Detail</a>

                        }
                        @if (User.Identity.IsAuthenticated && User.IsInRole("SuperAdmin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Edit</a>


                        }
                        @if (User.Identity.IsAuthenticated && User.IsInRole("SuperAdmin"))
                        {
                            <button data-id="@item.Id" class="btn btn-danger delete-slider-btn">Delete</button>



                        }
                    </td>
                </tr>

            }
        </tbody>
    </table>
</div>
